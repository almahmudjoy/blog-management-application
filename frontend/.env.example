# ---------------------------------------------------------------------------
# Blog REST API base URL. It MUST include the /api suffix, because every
# service call is built as `${NEXT_PUBLIC_API_URL}/blogs`, `/auth/login`, ...
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ---------------------------------------------------------------------------
# Optional. Origin that serves uploaded profile images when the API returns a
# bare file name or a relative path (e.g. "uploads/avatar-1.png").
# When omitted, the app falls back to the API origin (NEXT_PUBLIC_API_URL
# without the trailing /api).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_UPLOADS_URL=http://localhost:5000
