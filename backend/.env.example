DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=blogdb
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
NODE_ENV=development

# Email configuration for OTP and password-reset emails
