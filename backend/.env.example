# Local OTP for development only (used when NODE_ENV=development)
DEV_OTP=123456

# Demo admin account
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password123
ADMIN_DEMO_OTP=123456
